{
  "name": "audis",
  "version": "1.0.0",
  "description": "1-click audio processing desktop utility — Intro + Main + Outro stitching with crossfades",
  "type": "module",
  "main": "out/main/index.js",
  "author": "Audis",
  "license": "MIT",
  "scripts": {
    "dev": "node node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "node node_modules/electron-vite/bin/electron-vite.js build",
    "preview": "node node_modules/electron-vite/bin/electron-vite.js preview",
    "start": "node node_modules/electron-vite/bin/electron-vite.js dev",
    "dist": "npm run build && node node_modules/electron-builder/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^43.3.0",
    "electron-builder": "^24.13.3",
    "electron-playwright-helpers": "^2.1.0",
    "electron-vite": "^2.3.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "vitest": "^4.1.10",
    "wavesurfer.js": "^7.8.2"
  },
  "build": {
    "appId": "com.audis.app",
    "productName": "Audis",
    "files": [
      "out/**/*",
      "public/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "public/assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg-static",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe"
        ]
      },
      {
        "from": "node_modules/ffprobe-static/bin",
        "to": "ffprobe-static/bin"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
